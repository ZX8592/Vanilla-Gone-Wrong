{
  "type": "minecraft:entity",
  "random_sequence": "minecraft:entities/camel",
  "modifier": {
    "type": "minecraft:sequence",
    "functions": [
      {
        "item_filter": {
          "items": "#havoc:stack_limited_blocks"
        },
        "on_pass": {
          "type": "minecraft:filtered",
          "item_filter": {
            "items": "#havoc:compat/exempt_items"
          },
          "on_fail": {
            "type": "minecraft:filtered",
            "item_filter": {
              "predicates": {
                "minecraft:custom_data": "{havoc_compat_exempt:1b}"
              }
            },
            "on_fail": {
              "components": {
                "minecraft:max_stack_size": 16
              },
              "type": "minecraft:set_components"
            }
          }
        },
        "type": "minecraft:filtered"
      }
    ]
  }
}
